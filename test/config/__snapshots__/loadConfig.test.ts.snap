// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`loadConfig fault table > the rendered problem strings, which the README troubleshooting section quotes 1`] = `
[
  "AGENT_END_CALL: is not true or false, so true is used. Set it to true or false, or remove it.",
  "ANTHROPIC_API_KEY: is not set. API key for Anthropic. Create one at console.anthropic.com under API keys.",
  "AUTOMATION_PROVIDER: is none, so a handoff completes but nobody is notified. Set it to make, zapier or n8n and put your webhook URL in AUTOMATION_WEBHOOK_URL to post each handoff to your automation tool.",
  "AUTOMATION_PROVIDER: is not one of none, make, zapier, n8n. Set it to one of those values.",
  "AUTOMATION_TIMEOUT_MS: is not a whole number between 500 and 60000, so 5000 is used. Set it to a whole number in that range, or remove it.",
  "AUTOMATION_WEBHOOK_KEY: is set but the selected preset has no default header, so the key is not sent. Set AUTOMATION_WEBHOOK_KEY_HEADER to the header name your automation checks, or remove the key.",
  "AUTOMATION_WEBHOOK_KEY_HEADER: is not a valid header name, so the preset's header is used. Use letters, digits and - only, or remove it.",
  "AUTOMATION_WEBHOOK_URL: is not an https URL. Paste the full webhook URL from your automation tool; it must start with https://.",
  "AUTOMATION_WEBHOOK_URL: is not set. Paste the webhook URL from your automation tool, or set AUTOMATION_PROVIDER to none.",
  "AUTOMATION_WEBHOOK_URL: is set but AUTOMATION_PROVIDER is none, so it is ignored. Set AUTOMATION_PROVIDER to make, zapier or n8n.",
  "AUTOMATION_WEBHOOK_URL: points at a loopback or link-local address, which the server cannot reach. Use the public https URL of your webhook.",
  "HANDOFF_INCLUDE_TRANSCRIPT: is not true or false, so false is used. Set it to true or false, or remove it.",
  "IDLE_TIMEOUT_SECONDS: is not a whole number between 5 and 600, so 60 is used. Set it to a whole number in that range, or remove it.",
  "LLM_PROVIDER: cannot be used because this build registers no LLM providers. Report this as a bug; the registry in src/llm/registry.ts is empty.",
  "LLM_PROVIDER: is a test provider that is not meant for real calls. Set it to one of openai, anthropic, google, mistral, groq when you are done testing.",
  "LLM_PROVIDER: is not one of openai, anthropic, google, mistral, groq. Set it to one of those values.",
  "LLM_TIMEOUT_MS: is not a whole number between 1000 and 120000, so 20000 is used. Set it to a whole number in that range, or remove it.",
  "LOG_LEVEL: is not one of fatal, error, warn, info, debug, so info is used. Set it to one of those values, or remove it.",
  "MAX_CALL_SECONDS: is not a whole number between 30 and 14400, so 900 is used. Set it to a whole number in that range, or remove it.",
  "MAX_CONCURRENT_CALLS: is not a whole number between 1 and 100, so 10 is used. Set it to a whole number in that range, or remove it.",
  "PORT: is not a whole number between 1 and 65535, so 3000 is used. Set it to a whole number in that range, or remove it.",
  "PUBLIC_HOST: contains a scheme or a path, which the server ignored. Set it to the host only, like my-app.up.railway.app.",
  "PUBLIC_HOST: is not a host name. Set it to the host only, like my-app.up.railway.app, with no https:// and no path, or remove it to use RAILWAY_PUBLIC_DOMAIN.",
  "PUBLIC_HOST: is not set and Railway did not provide RAILWAY_PUBLIC_DOMAIN. Generate a domain for the service in Railway under Settings, Networking, or set PUBLIC_HOST to the host name Twilio will connect to, like my-app.up.railway.app.",
  "RAILWAY_PUBLIC_DOMAIN: is not a host name, so it is ignored. Set PUBLIC_HOST to the host name Twilio will connect to.",
  "STATUS_TOKEN: contains characters that cannot go in a URL, so it is ignored and the page stays locked. Use only letters, digits, - and _.",
  "STATUS_TOKEN: is not set, so the status page hides the Twilio URL, the self-test and the test chat. Set it to a random string of at least 16 letters and digits, then open the page with ?token=<STATUS_TOKEN>.",
  "STATUS_TOKEN: is shorter than 16 characters, so it is ignored and the page stays locked. Set it to a random string of at least 16 letters and digits.",
  "TWILIO_AUTH_TOKEN: is not set, so Twilio signatures cannot be checked. Copy the Auth Token from the Account Info panel of the Twilio Console.",
  "TWILIO_AUTH_TOKEN: is not set. Copy the Auth Token from the Account Info panel of the Twilio Console.",
  "TWILIO_SIGNATURE_MODE: is not one of enforce, warn, so enforce is used. Set it to one of those values, or remove it.",
  "TWILIO_SIGNATURE_MODE: is warn, so connections with a missing or wrong Twilio signature are allowed. Set it to enforce once your calls connect.",
  "WS_SECRET: contains characters that cannot go in a URL. Use only letters, digits, - and _.",
  "WS_SECRET: is not set. Set it to a random string of at least 24 letters and digits. The Railway template generates one for you.",
  "WS_SECRET: is shorter than 24 characters. Set it to a random string of at least 24 letters and digits.",
]
`;
