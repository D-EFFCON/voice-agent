# voice-server environment variables.
# Generated by `pnpm docs:env` from src/config/schema.ts. Do not edit by hand.
# Local runs: copy to .env. Railway: set these as service variables.
# Blank secrets are yours to fill in. A commented-out variable is optional or set by Railway.

# --- Server ---

# Port the server listens on. Railway sets this for you.
# Required: no. Default: 3000.
PORT=3000

# How much the server logs. debug also logs what callers and the model say. Values: fatal, error, warn, info, debug.
# Required: no. Default: info.
LOG_LEVEL=info

# Host name Twilio connects to, without https:// or a path. Leave it unset on Railway: RAILWAY_PUBLIC_DOMAIN is used.
# Required: when RAILWAY_PUBLIC_DOMAIN is not set.
PUBLIC_HOST=

# --- Twilio and secrets ---

# Random string that becomes part of the WebSocket URL you paste into Twilio. At least 24 letters, digits, - or _.
# Required: yes. Secret.
WS_SECRET=

# Your Twilio Auth Token, used to check that each connection really comes from Twilio. Find it in the Account Info panel of the Twilio Console.
# Required: when TWILIO_SIGNATURE_MODE is enforce. Secret.
TWILIO_AUTH_TOKEN=

# enforce refuses connections with a missing or wrong Twilio signature. warn lets them through and shows a warning on the status page; use it only while you are stuck. Values: enforce, warn.
# Required: no. Default: enforce.
TWILIO_SIGNATURE_MODE=enforce

# Unlocks the Twilio URL, the self-test and the test chat on the status page: open /?token=<STATUS_TOKEN> once. At least 16 letters, digits, - or _. Unset keeps those parts hidden.
# Required: no. Secret.
STATUS_TOKEN=

# --- LLM ---

# Which LLM answers callers. Values: openai, anthropic, google, mistral, groq.
# Required: no. Default: openai.
LLM_PROVIDER=openai

# Model name for the provider. Unset uses the provider's fast default.
# Required: no. Default: the provider's default (openai: gpt-4o-mini, anthropic: claude-haiku-4-5-20251001, google: gemini-2.5-flash, mistral: mistral-small-latest, groq: llama-3.3-70b-versatile).
# LLM_MODEL=

# API key for OpenAI. Create one at platform.openai.com under API keys.
# Required: when LLM_PROVIDER is openai. Secret.
OPENAI_API_KEY=

# API key for Anthropic. Create one at console.anthropic.com under API keys.
# Required: when LLM_PROVIDER is anthropic. Secret.
ANTHROPIC_API_KEY=

# API key for Google Generative AI. Create one in Google AI Studio.
# Required: when LLM_PROVIDER is google. Secret.
GOOGLE_GENERATIVE_AI_API_KEY=

# API key for Mistral. Create one at console.mistral.ai under API keys.
# Required: when LLM_PROVIDER is mistral. Secret.
MISTRAL_API_KEY=

# API key for Groq. Create one at console.groq.com under API keys.
# Required: when LLM_PROVIDER is groq. Secret.
GROQ_API_KEY=

# How long to wait for the model, in milliseconds: for the whole reply and for any gap between words. On timeout the caller hears FALLBACK_MESSAGE and goes to a person.
# Required: no. Default: 20000.
LLM_TIMEOUT_MS=20000

# --- Prompt and spoken messages ---

# Instructions for the AI, including its name and your business name. Multi-line values are fine.
# Required: no. Default: the bundled complaints-line prompt (src/config/defaults.ts).
# SYSTEM_PROMPT=

# Spoken when the model fails or times out, before the caller goes to a person.
# Required: no. Default: Sorry, I am having trouble right now. Let me put you through to a person.
FALLBACK_MESSAGE="Sorry, I am having trouble right now. Let me put you through to a person."

# Spoken when the AI hands the caller to a person and has not already said so.
# Required: no. Default: One moment while I put you through to the team.
HANDOFF_MESSAGE="One moment while I put you through to the team."

# Spoken when a call reaches MAX_CALL_SECONDS, before it ends.
# Required: no. Default: We have reached the time limit for this call. Thank you for calling. Goodbye.
CLOSING_MESSAGE="We have reached the time limit for this call. Thank you for calling. Goodbye."

# --- Automation ---

# Which automation tool receives each handoff. none completes the handoff without telling anyone. Values: none, make, zapier, n8n.
# Required: no. Default: none.
AUTOMATION_PROVIDER=none

# The webhook URL from your automation tool. Must start with https://.
# Required: unless AUTOMATION_PROVIDER is none.
AUTOMATION_WEBHOOK_URL=

# Key sent in a header with each webhook call, if your webhook checks one.
# Required: no. Secret.
AUTOMATION_WEBHOOK_KEY=

# Header that carries AUTOMATION_WEBHOOK_KEY. Unset uses the preset's header (make: x-make-apikey, n8n: x-api-key).
# Required: no. Default: the preset's header.
# AUTOMATION_WEBHOOK_KEY_HEADER=

# How long to wait for the webhook to answer, in milliseconds.
# Required: no. Default: 5000.
AUTOMATION_TIMEOUT_MS=5000

# true sends the call transcript to the webhook with each handoff. false sends the summary only. Values: true, false.
# Required: no. Default: false.
HANDOFF_INCLUDE_TRANSCRIPT=false

# --- Call limits ---

# true lets the AI end the call after saying goodbye. false means only a handoff, the caller or a timeout ends it. Values: true, false.
# Required: no. Default: true.
AGENT_END_CALL=true

# Longest a call may run. At the limit the server speaks CLOSING_MESSAGE and ends the call.
# Required: no. Default: 900.
MAX_CALL_SECONDS=900

# How long a caller may stay silent before the call ends.
# Required: no. Default: 60.
IDLE_TIMEOUT_SECONDS=60

# Calls handled at the same time. Further calls are refused and take the failure path of your Studio flow.
# Required: no. Default: 10.
MAX_CONCURRENT_CALLS=10

# --- Set by Railway ---

# Set by Railway when you generate a domain for the service. Used as the public host when PUBLIC_HOST is unset.
# Required: set by Railway.
# RAILWAY_PUBLIC_DOMAIN=

# Set by Railway to the deployed commit. Shown as the build on the status page and in the logs.
# Required: set by Railway.
# RAILWAY_GIT_COMMIT_SHA=
